# ====== Text-to-speech ======
# ElevenLabs: https://elevenlabs.io  -> Profile -> API key
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Minimax: https://platform.minimaxi.chat -> API key + GroupId
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
# Ban quoc te dung api.minimaxi.chat, ban TQ dung api.minimax.chat
MINIMAX_BASE_URL=https://api.minimaxi.chat
MINIMAX_MODEL=speech-02-hd
MINIMAX_VOICE_ID=

# ====== Sinh prompt anh tu loi thoai (Claude) ======
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ====== Sinh anh ======
# provider: whisk | gemini | placeholder
IMAGE_PROVIDER=gemini
# Google AI Studio key (cho provider gemini)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Thu muc profile Chrome de giu dang nhap Google cho provider whisk
WHISK_PROFILE_DIR=.autostory/whisk-profile
WHISK_HEADLESS=false

# ====== CapCut ======
# Thu muc chua cac draft cua CapCut tren may ban, vi du:
#   Windows: C:/Users/<ten>/AppData/Local/CapCut/User Data/Projects/com.lveditor.draft
#   macOS:   /Users/<ten>/Movies/CapCut/User Data/Projects/com.lveditor.draft
CAPCUT_DRAFT_DIR=
