    "currency": "VND",
    "note": "Số tiền là VND (số nguyên). Tỉ lệ phần trăm ghi dạng thập phân: 0.005 = 0.5%. Cơ chế này thay thế tất cả cơ chế ban hành trước đó.",
    "source_documents": [
      "2026 Cơ chế CSKH - Kaimen (Tiểu Đêm)",
      "2026 Cơ chế CSKH - Cao Phục Khớp",
      "2026 Cơ chế Sale - Tiểu Đêm",
      "2026 Cơ chế Sale - Cao Phục Khớp"
    ]
  },

  "engine_spec": {
    "description": "Đặc tả để app bất kỳ đọc file này và tính lương đúng. App KHÔNG hard-code con số nào — mọi con số lấy từ file này.",
    "tier_table_semantics": "Mỗi tier_table là danh sách bậc [{min, max, value}]. Tìm bậc có min <= x < max (max = null nghĩa là vô cùng) rồi lấy value. Đây là bảng TRA PHẲNG (flat lookup), KHÔNG phải lũy tiến từng phần: hoa hồng = DSTC * value của bậc chứa DSTC.",
    "threshold_table_semantics": "Mỗi threshold_table là danh sách [{gte, value}] sắp xếp tăng dần. Lấy value của ngưỡng LỚN NHẤT mà x >= gte; nếu x nhỏ hơn mọi ngưỡng thì value = 0.",
    "rounding": "Tính bằng số thực, làm tròn kết quả cuối cùng về đồng (0 chữ số thập phân).",
    "calculation_order": [
      "1. luong_co_ban = (lcb / cong_dinh_muc) * min(ngay_cong, cong_dinh_muc) + (lcb / cong_dinh_muc) * max(ngay_cong - cong_dinh_muc, 0) * he_so_vuot_cong",
      "2. luong_trach_nhiem = tn nếu ngay_cong_hanh_chinh >= số công yêu cầu của vị trí (xem work_rules.dieu_kien_trach_nhiem), ngược lại = 0",
      "3. he_so_duy_tri: nếu nhân sự KHÔNG đạt điều kiện duy trì vị trí trong kỳ (theo mục duy_tri của vị trí) thì CHỈ luong_co_ban nhân với 0.8; luong_trach_nhiem GIỮ NGUYÊN (đã chốt 05/09/2026)",
      "4. hoa_hong_ca_nhan = dstc * tra_bang(commission_table của bộ phận, dstc). Áp dụng cho các vị trí có ca_nhan = true (nhân viên các bậc và Leader — 'Leader hưởng thưởng cá nhân như nhân viên')",
      "5. thuong_kpi = hoa_hong_ca_nhan * tra_nguong(kpi_bonus của bộ phận, chỉ_số_kpi). Bộ phận CSKH: chỉ_số_kpi = ty_le_dat_kpi (dstc_thực_tế / kpi_mục_tiêu, tính theo kpi_target_schedule). Bộ phận SALE: chỉ_số_kpi = dstc / so_sdt_hop_le (DSTC trên 1 số điện thoại, đã loại số ảo)",
      "6. thuong_ty_le_thanh_cong (chỉ SALE) = hoa_hong_ca_nhan * tra_nguong(success_rate_bonus, ty_le_thanh_cong)",
      "7. hoa_hong_doi_nhom (Leader/TP/GĐ) = rate * dstc_team + split_schedule[thang_sau_tach - 1] * dstc_team_tach (nếu có team tách, trong số tháng quy định). DSTC team không bao gồm DSTC cá nhân Leader/Trưởng phòng",
      "8. thu_nhap_chu_tich = 10% lợi nhuận nhánh gốc + 5% lợi nhuận các nhánh tách",
      "9. phu_cap_truc_toi (chỉ SALE) = 50000 * số buổi trực đạt điều kiện (DSCĐ >= 3.000.000 và đủ 3.5 tiếng, khung 18h-22h)",
      "10. phat_hoan = 30000 * so_don_hoan_vuot_muc (trừ vào lương thực nhận)",
      "11. luong_thuc_nhan = luong_co_ban * he_so_duy_tri + luong_trach_nhiem + hoa_hong_ca_nhan + thuong_kpi + thuong_ty_le_thanh_cong + hoa_hong_doi_nhom + thu_nhap_chu_tich + phu_cap_truc_toi - phat_hoan"
    ],
    "inputs": [
      { "key": "bo_phan", "label": "Bộ phận", "type": "enum", "values": ["CSKH_KAIMEN", "CSKH_CPK", "SALE_TIEU_DEM", "SALE_CPK"] },
      { "key": "vi_tri", "label": "Vị trí", "type": "enum", "values": ["hoc_viec", "chinh_thuc", "chuyen_vien_1", "chuyen_vien_2", "leader", "truong_phong", "giam_doc", "chu_tich"] },
      { "key": "ngay_cong", "label": "Ngày công thực tế", "type": "number", "unit": "công" },
      { "key": "ngay_cong_hanh_chinh", "label": "Ngày công hành chính", "type": "number", "unit": "công", "note": "Dùng xét điều kiện nhận lương trách nhiệm" },
      { "key": "dat_duy_tri", "label": "Đạt điều kiện duy trì vị trí trong kỳ", "type": "boolean", "default": true },
      { "key": "dstc", "label": "Doanh số thành công cá nhân (DSTC)", "type": "number", "unit": "VND" },
      { "key": "ty_le_dat_kpi", "label": "Tỉ lệ đạt KPI mục tiêu (CSKH)", "type": "number", "unit": "ratio", "note": "= DSTC resale thực tế / KPI mục tiêu. KPI mục tiêu = Σ(DS nhận kỳ gốc tháng Ti × kpi_target_schedule[Ti])" },
      { "key": "so_sdt_hop_le", "label": "Số SĐT hợp lệ được giao (SALE)", "type": "number", "unit": "số", "note": "Đã trừ 5% số trêu/số sai/số không đúng" },
      { "key": "ty_le_thanh_cong", "label": "Tỉ lệ giao hàng thành công (SALE)", "type": "number", "unit": "ratio" },
      { "key": "so_don_hoan_vuot", "label": "Số đơn hoàn vượt định mức", "type": "number", "unit": "đơn" },
      { "key": "dstc_team", "label": "DSTC đội nhóm / phòng (không gồm DSTC cá nhân Leader, Trưởng phòng)", "type": "number", "unit": "VND" },
      { "key": "dstc_team_tach", "label": "DSTC team/phòng đã tách (nhân bản)", "type": "number", "unit": "VND" },
      { "key": "thang_sau_tach", "label": "Tháng thứ mấy kể từ khi tách team/phòng", "type": "number", "unit": "tháng" },
      { "key": "loi_nhuan_goc", "label": "Lợi nhuận nhánh gốc (Chủ tịch)", "type": "number", "unit": "VND" },
      { "key": "loi_nhuan_nhanh_tach", "label": "Lợi nhuận các nhánh tách (Chủ tịch)", "type": "number", "unit": "VND" },
      { "key": "so_buoi_truc_toi_dat", "label": "Số buổi trực tối đạt điều kiện (SALE)", "type": "number", "unit": "buổi" }
    ]
  },

